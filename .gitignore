# Secrets - never upload
.env
*.env
!.env.example

# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]

# Runtime output - only the sample_* files are committed as proof
outputs/*
!outputs/sample_*
!outputs/.gitkeep
logs/*
!logs/sample_*.log
!logs/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
